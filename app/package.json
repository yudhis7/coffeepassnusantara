{
  "name": "kopipass-nusantara",
  "productName": "KopiPass Nusantara",
  "version": "0.2.0",
  "private": true,
  "description": "KopiPass Nusantara - langganan kopi lintas kedai lokal (prototipe)",
  "author": "yudhis7 (https://github.com/yudhis7)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "electron:dev": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --publish never",
    "android:sync": "vite build && cap sync android",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/core": "6.2.1",
    "leaflet": "1.9.4",
    "qrcode.react": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "@types/leaflet": "1.9.14",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "playwright": "1.63.0",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  },
  "build": {
    "appId": "id.kopipass.nusantara",
    "productName": "KopiPass Nusantara",
    "copyright": "Project ideation: yudhis7",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "KopiPass-Nusantara-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "KopiPass-Nusantara-Portable-${version}.exe"
    }
  }
}
